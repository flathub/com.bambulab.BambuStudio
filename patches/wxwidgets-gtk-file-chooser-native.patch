     void SetPath(const wxString& path) wxOVERRIDE;
 
-
     // Implementation only.
 
     void GTKOnAccept();
@@ -54,7 +54,10 @@ protected:
 
 
 private:
+    void GTKAccept();
+    GtkFileChooser* m_fileChooser = nullptr;
+
     wxDECLARE_DYNAMIC_CLASS(wxDirDialog);
