 src/gtk/dirdlg.cpp       |  61 ++++++++++++++++++----
 src/gtk/filedlg.cpp      | 109 ++++++++++++++++++++++++++++++++++-----
 4 files changed, 163 insertions(+), 31 deletions(-)

diff --git a/include/wx/gtk/dirdlg.h b/include/wx/gtk/dirdlg.h
