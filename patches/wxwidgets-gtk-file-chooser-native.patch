From: Vadim Zeitlin <vadim@wxwidgets.org>
Date: Thu, 3 Jul 2025 00:47:58 +0200
Subject: [PATCH 3/6] Add wxFileDialog::GetFileChooser() helper

Simplify the code by adding a trivial member function returning the
right wxGtkFileChooser to use instead of repeating the same fragment in
multiple places.

No real changes.

(cherry picked from commit 9b3a4c47f7f6b6b79bd84262296d428aa510f02e)
---
 include/wx/gtk/filedlg.h |  5 +++++
 src/gtk/filedlg.cpp      | 15 +++++----------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/include/wx/gtk/filedlg.h b/include/wx/gtk/filedlg.h
index 7a837d308e..8982f0b12f 100644
--- a/include/wx/gtk/filedlg.h
+++ b/include/wx/gtk/filedlg.h
@@ -81,6 +81,11 @@ private:
     void OnSize(wxSizeEvent&);
     virtual void AddChildGTK(wxWindowGTK* child) wxOVERRIDE;
 
+    const wxGtkFileChooser& GetFileChooser() const
+    {
+        return m_fcNative ? *m_fcNative : m_fc;
+    }
+
     wxGtkFileChooser    m_fc;
     wxGtkFileChooser* m_fcNative = nullptr;
     GtkFileChooser* m_fileChooserNative = nullptr;
diff --git a/src/gtk/filedlg.cpp b/src/gtk/filedlg.cpp
index 75a88d6d1e..bd195b4891 100644
--- a/src/gtk/filedlg.cpp
+++ b/src/gtk/filedlg.cpp
@@ -479,20 +479,17 @@ void wxFileDialog::OnSize(wxSizeEvent&)
 wxString wxFileDialog::GetPath() const
 {
     wxCHECK_MSG( !HasFlag(wxFD_MULTIPLE), wxString(), "When using wxFD_MULTIPLE, must call GetPaths() instead" );
-    const wxGtkFileChooser& fc = m_fcNative ? *m_fcNative : m_fc;
-    return fc.GetPath();
+    return GetFileChooser().GetPath();
 }
 
 void wxFileDialog::GetFilenames(wxArrayString& files) const
 {
-    const wxGtkFileChooser& fc = m_fcNative ? *m_fcNative : m_fc;
-    fc.GetFilenames(files);
+    GetFileChooser().GetFilenames(files);
 }
 
 void wxFileDialog::GetPaths(wxArrayString& paths) const
 {
-    const wxGtkFileChooser& fc = m_fcNative ? *m_fcNative : m_fc;
-    fc.GetPaths(paths);
+    GetFileChooser().GetPaths(paths);
 }
 
 void wxFileDialog::SetMessage(const wxString& message)
@@ -557,8 +554,7 @@ wxString wxFileDialog::GetFilename() const
 {
     wxCHECK_MSG( !HasFlag(wxFD_MULTIPLE), wxString(), "When using wxFD_MULTIPLE, must call GetFilenames() instead" );
 
-    const wxGtkFileChooser& fc = m_fcNative ? *m_fcNative : m_fc;
-    wxString currentFilename(fc.GetFilename());
+    wxString currentFilename(GetFileChooser().GetFilename());
     if (currentFilename.empty())
     {
         // m_fc.GetFilename() will return empty until the dialog has been shown
@@ -585,8 +581,7 @@ void wxFileDialog::SetFilterIndex(int filterIndex)
 
 int wxFileDialog::GetFilterIndex() const
 {
-    const wxGtkFileChooser& fc = m_fcNative ? *m_fcNative : m_fc;
-    return fc.GetFilterIndex();
+    return GetFileChooser().GetFilterIndex();
 }
 
 void wxFileDialog::GTKSelectionChanged(const wxString& filename)

From 820bce94776189b5bea76c2602a59e610bb71712 Mon Sep 17 00:00:00 2001
From: Vadim Zeitlin <vadim@wxwidgets.org>
Date: Thu, 3 Jul 2025 14:38:20 +0200
Subject: [PATCH 4/6] Check result of chdir() when using native file dialog

Do it for consistency with the case when we use the GTK dialog and also
to avoid -Wunused-result from gcc due to not checking the return value
of chdir().

(cherry picked from commit ae8998c7e08889b632f573cd5508068798b0a96a)
---
 src/gtk/filedlg.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/gtk/filedlg.cpp b/src/gtk/filedlg.cpp
index bd195b4891..334a3a3003 100644
--- a/src/gtk/filedlg.cpp
+++ b/src/gtk/filedlg.cpp
@@ -435,7 +435,11 @@ int wxFileDialog::ShowModal()
             {
                 wxGtkString filename(gtk_file_chooser_get_filename(GTK_FILE_CHOOSER(m_fileChooserNative)));
                 wxGtkString dir(g_path_get_dirname(filename));
-                chdir(dir);
+                if ( chdir(dir) != 0 )
+                {
+                    wxLogSysError(_("Changing current directory to \"%s\" failed"),
+                                  wxString::FromUTF8(dir));
+                }
             }
             m_returnCode = wxID_OK;
         }

From 292eac0d3764d7cf9e14d234b40df6a34e09ffc7 Mon Sep 17 00:00:00 2001
From: Paul Cornett <paulcor@users.noreply.github.com>
Date: Fri, 4 Jul 2025 17:27:19 -0700
Subject: [PATCH 5/6] Fix wxFilePickerCtrl with GTK >= 3.20

GtkFileChooserNative will not be used when wxFileDialog is used by
wxFilePickerCtrl, so make sure values will be retrieved from
GtkFileChooserDialog and not the unused "native" chooser.
See #25590

(cherry picked from commit ec57a70bc2ffbc6525321ee06f8d05b084808c6a)
---
 include/wx/gtk/filedlg.h |  1 +
 src/gtk/filedlg.cpp      | 28 +++++++++++++++++++++++-----
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/include/wx/gtk/filedlg.h b/include/wx/gtk/filedlg.h
index 8982f0b12f..7e4082af24 100644
--- a/include/wx/gtk/filedlg.h
+++ b/include/wx/gtk/filedlg.h
@@ -66,6 +66,7 @@ public:
 
     // Implementation only.
     void GTKSelectionChanged(const wxString& filename);
+    void GTKDropNative();
 
 
 protected:
diff --git a/src/gtk/filedlg.cpp b/src/gtk/filedlg.cpp
index 334a3a3003..b088c6a0f8 100644
--- a/src/gtk/filedlg.cpp
+++ b/src/gtk/filedlg.cpp
@@ -153,6 +153,15 @@ static void gtk_filedialog_update_preview_callback(GtkFileChooser *chooser,
     gtk_file_chooser_set_preview_widget_active(chooser, have_preview);
 }
 
+#if GTK_CHECK_VERSION(3,20,0)
+static void wx_filedialog_show(GtkWidget*, wxFileDialog* win)
+{
+    // If m_widget is shown, then GtkFileChooserNative is not being used.
+    // This happens when using wxFilePickerCtrl, for example.
+    win->GTKDropNative();
+}
+#endif
+
 } // extern "C"
 
 void wxFileDialog::AddChildGTK(wxWindowGTK* child)
@@ -262,6 +271,7 @@ bool wxFileDialog::Create(wxWindow *parent, const wxString& message,
             m_message.utf8_str(), gtk_parent, gtk_action, nullptr, nullptr));
         m_fcNative = new wxGtkFileChooser;
         m_fcNative->SetWidget(m_fileChooserNative);
+        g_signal_connect(m_widget, "show", G_CALLBACK(wx_filedialog_show), this);
     }
 #endif
 
@@ -410,6 +420,17 @@ void wxFileDialog::OnFakeOk(wxCommandEvent& WXUNUSED(event))
     EndDialog(wxID_OK);
 }
 
+void wxFileDialog::GTKDropNative()
+{
+    if (m_fileChooserNative)
+    {
+        delete m_fcNative;
+        m_fcNative = nullptr;
+        g_object_unref(m_fileChooserNative);
+        m_fileChooserNative = nullptr;
+    }
+}
+
 int wxFileDialog::ShowModal()
 {
     WX_HOOK_MODAL_DIALOG();
@@ -417,13 +438,10 @@ int wxFileDialog::ShowModal()
     CreateExtraControl();
 
 #if GTK_CHECK_VERSION(3,20,0)
-    if (m_fileChooserNative && m_extraControl)
+    if (m_extraControl)
     {
         // GtkFileChooserNative does not support extra controls
-        delete m_fcNative;
-        m_fcNative = nullptr;
-        g_object_unref(m_fileChooserNative);
-        m_fileChooserNative = nullptr;
+        GTKDropNative();
     }
     if (m_fileChooserNative)
     {

From 9aae5345253e6784dae27352f85f34899829da0c Mon Sep 17 00:00:00 2001
From: Scott Hanson <scooter_seh@yahoo.com>
Date: Mon, 17 Nov 2025 10:04:39 -0500
Subject: [PATCH 6/6] Fix wxFileDialog::GetDirectory() when using wxFD_MULTIPLE
 in wxGTK

This function returned an empty string, override it to forward it to the
file chooser actually being used to fix this.

Closes #25976.

Closes #25977.

(cherry picked from commit de0c23ea026114b72e306a6076dffe01ebf9fa2a)
---
 include/wx/gtk/filedlg.h | 1 +
 src/gtk/filedlg.cpp      | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/include/wx/gtk/filedlg.h b/include/wx/gtk/filedlg.h
index 7e4082af24..39f9900768 100644
--- a/include/wx/gtk/filedlg.h
+++ b/include/wx/gtk/filedlg.h
@@ -48,6 +48,7 @@ public:
     virtual wxString GetFilename() const wxOVERRIDE;
     virtual void GetFilenames(wxArrayString& files) const wxOVERRIDE;
     virtual int GetFilterIndex() const wxOVERRIDE;
+    virtual wxString GetDirectory() const wxOVERRIDE;
 
     virtual void SetMessage(const wxString& message) wxOVERRIDE;
     virtual void SetPath(const wxString& path) wxOVERRIDE;
diff --git a/src/gtk/filedlg.cpp b/src/gtk/filedlg.cpp
index b088c6a0f8..13140bf4cd 100644
--- a/src/gtk/filedlg.cpp
+++ b/src/gtk/filedlg.cpp
@@ -514,6 +514,11 @@ void wxFileDialog::GetPaths(wxArrayString& paths) const
     GetFileChooser().GetPaths(paths);
 }
 
+wxString wxFileDialog::GetDirectory() const
+{
+    return GetFileChooser().GetDirectory();
+}
+
 void wxFileDialog::SetMessage(const wxString& message)
 {
     m_message = message;
